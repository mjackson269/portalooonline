---
import Layout from "../layouts/Layout.astro";
import { getCities } from "../data/cities.ts";

export function getStaticPaths() {
  return getCities().map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const suppliers = city.suppliers;

const pageTitle = `Portaloo Hire ${city.name} | Portaloo Online`;
const description = `Compare portable toilet hire companies serving ${city.name} and the surrounding ${city.region} area.`;
---

<Layout title={pageTitle} description={description}>

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{city.region} suppliers</span>

      <h1>Portaloo Hire {city.name}</h1>

      <p>
        Compare portable toilet suppliers serving {city.name} and the
        surrounding {city.region} area.
      </p>

      <div class="summary">
        <strong>{suppliers.length}</strong>
        <span>suppliers currently listed</span>
      </div>
    </div>
  </section>

  <section class="directory">
    <div class="container">

      <div class="section-heading">
        <div>
          <h2>Portable toilet hire companies in {city.name}</h2>

          <p>
            Compare services and contact suppliers directly for prices
            and availability.
          </p>
        </div>
      </div>

      <div class="supplier-grid">
        {suppliers.map((supplier) => (
          <article class="supplier-card">

            <div class="supplier-header">
              <div>
                {supplier.location && (
                  <p class="supplier-location">{supplier.location}</p>
                )}

                <h3>{supplier.company}</h3>
              </div>

              {supplier.featured && (
                <span class="featured-badge">
                  Featured
                </span>
              )}
            </div>

            <p class="supplier-description">
              {supplier.description}
            </p>

            <ul class="service-list">
              {(supplier.services ?? []).map((service) => (
                <li>{service}</li>
              ))}
            </ul>

            <div class="supplier-contact">
              {supplier.phone && (
              <a
                class="phone-button"
                href={`tel:${supplier.phone.replace(/\s/g, "")}`}
              >
                Call {supplier.phone}
              </a>

              <a
                class="website-button"
                href={supplier.website}
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit website
              </a>
              )}
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 90px 0 70px;
    background:
      linear-gradient(
        135deg,
        #eff6ff 0%,
        #f8fafc 55%,
        #ecfeff 100%
      );
    border-bottom: 1px solid #e2e8f0;
  }

  .page-hero .container {
    max-width: 1180px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    padding: 7px 13px;
    color: #1d4ed8;
    background: #dbeafe;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .page-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .page-hero p {
    max-width: 750px;
    margin: 22px 0 0;
    color: #475569;
    font-size: 1.2rem;
  }

  .summary {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 28px;
    color: #475569;
  }

  .summary strong {
    color: #2563eb;
    font-size: 1.5rem;
  }

  .directory {
    padding: 72px 0;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    letter-spacing: -0.025em;
  }

  .section-heading p {
    margin: 8px 0 0;
    color: #64748b;
  }

  .supplier-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .supplier-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .supplier-card:hover {
    transform: translateY(-4px);
    border-color: #bfdbfe;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.09);
  }

  .supplier-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .supplier-location {
    margin: 0 0 5px;
    color: #2563eb;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .supplier-card h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .featured-badge {
    height: fit-content;
    padding: 6px 10px;
    color: #92400e;
    background: #fef3c7;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .supplier-description {
    margin: 18px 0;
    color: #64748b;
  }

  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .service-list li {
    padding: 6px 10px;
    color: #334155;
    background: #f1f5f9;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .supplier-contact {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid #e2e8f0;
  }

  .supplier-contact a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .phone-button {
    color: #ffffff;
    background: #2563eb;
  }

  .phone-button:hover {
    background: #1d4ed8;
  }

  .website-button {
    color: #1e293b;
    background: #ffffff;
    border: 1px solid #cbd5e1;
  }

  .website-button:hover {
    border-color: #2563eb;
    color: #2563eb;
  }

  @media (max-width: 600px) {
    .page-hero {
      padding: 60px 0 50px;
    }

    .directory {
      padding: 50px 0;
    }

    .supplier-grid {
      grid-template-columns: 1fr;
    }

    .supplier-card {
      padding: 22px;
    }

    .supplier-contact {
      flex-direction: column;
    }

    .supplier-contact a {
      width: 100%;
    }
  }
</style>