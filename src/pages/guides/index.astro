---
import Layout from "../../layouts/Layout.astro";

const guides = [
  {
    slug: "how-many-portable-toilets-for-an-event",
    title: "How Many Portable Toilets Do I Need for an Event?",
    description: "Estimate event toilet numbers using attendance, duration, alcohol, accessibility and servicing requirements.",
    category: "Event planning",
    readTime: "8 minute read"
  },
  {
    slug: "wedding-toilet-hire",
    title: "Wedding Toilet Hire: A Complete Planning Guide",
    description: "Plan luxury toilet trailers, accessible facilities, guest capacity, venue access, utilities and supplier questions for a wedding.",
    category: "Weddings",
    readTime: "9 minute read"
  },
  {
    slug: "portable-toilet-hire-cost",
    title: "How Much Does Portable Toilet Hire Cost?",
    description: "Compare indicative UK prices for site toilets, event units, accessible toilets, welfare units and luxury toilet trailers.",
    category: "Costs",
    readTime: "9 minute read"
  }
];
---

<Layout title="Portable Toilet Hire Guides | Portaloo Online" description="Practical UK guides for portable toilet hire, wedding toilets, events, construction sites, accessible facilities and temporary welfare planning.">
  <main class="guides-page">
    <section class="guides-hero">
      <div class="container">
        <p class="eyebrow">Portable toilet hire advice</p>
        <h1>Portable Toilet Hire Guides</h1>
        <p class="hero-intro">
          Practical planning information for events, weddings, construction sites
          and temporary facilities, with clear links to suppliers serving your area.
        </p>
      </div>
    </section>

    <section class="guides-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="section-label">Planning resources</p>
            <h2>Latest guides</h2>
          </div>
          <p>Clear answers to common questions about temporary toilet and welfare facilities.</p>
        </div>

        <div class="guides-grid">
          {guides.map((guide) => (
            <article class="guide-card">
              <div class="guide-meta">
                <span class="guide-category">{guide.category}</span>
                <span>{guide.readTime}</span>
              </div>
              <h2><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h2>
              <p>{guide.description}</p>
              <a class="guide-link" href={`/guides/${guide.slug}/`} aria-label={`Read ${guide.title}`}>
                Read guide <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="directory-cta">
      <div class="container cta-content">
        <div>
          <h2>Looking for a toilet hire company?</h2>
          <p>Browse portable toilet and luxury trailer suppliers serving locations across the UK.</p>
        </div>
        <a class="cta-button" href="/locations/">Browse locations</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .guides-page { background: #f8fafc; color: #0f172a; }
  .container { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; }
  .guides-hero { padding: 5rem 0 4rem; color: #fff; background: radial-gradient(circle at top right, rgba(59,130,246,.35), transparent 38%), linear-gradient(135deg,#0f172a,#172554); }
  .eyebrow, .section-label { margin: 0 0 .75rem; color: #93c5fd; font-size: .8rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .guides-hero h1 { max-width: 760px; margin: 0; color: #fff; font-size: clamp(2.4rem,7vw,4.5rem); line-height: 1.05; letter-spacing: -.045em; }
  .hero-intro { max-width: 720px; margin: 1.5rem 0 0; color: #dbeafe; font-size: clamp(1.05rem,2.4vw,1.25rem); line-height: 1.7; }
  .guides-section { padding: 4rem 0 5rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 3rem; margin-bottom: 2rem; }
  .section-heading h2 { margin: 0; font-size: clamp(1.8rem,4vw,2.5rem); letter-spacing: -.03em; }
  .section-heading > p { max-width: 500px; margin: 0; color: #475569; line-height: 1.7; }
  .guides-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.25rem; }
  .guide-card { display: flex; min-height: 300px; flex-direction: column; padding: 1.5rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 8px 30px rgba(15,23,42,.06); }
  .guide-card:hover { border-color: #93c5fd; box-shadow: 0 14px 36px rgba(15,23,42,.1); transform: translateY(-2px); }
  .guide-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; margin-bottom: 1.25rem; color: #64748b; font-size: .8rem; }
  .guide-category { color: #2563eb; font-weight: 800; }
  .guide-card h2 { margin: 0; font-size: 1.35rem; line-height: 1.3; }
  .guide-card h2 a { color: #0f172a; text-decoration: none; }
  .guide-card h2 a:hover { color: #2563eb; }
  .guide-card p { margin: 1rem 0 1.5rem; color: #475569; line-height: 1.65; }
  .guide-link { display: inline-flex; align-items: center; gap: .5rem; margin-top: auto; color: #2563eb; font-weight: 800; text-decoration: none; }
  .guide-link:hover { color: #1d4ed8; text-decoration: underline; }
  .directory-cta { padding: 3rem 0; background: #eff6ff; border-top: 1px solid #bfdbfe; }
  .cta-content { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .cta-content h2 { margin: 0 0 .5rem; font-size: 1.75rem; }
  .cta-content p { margin: 0; color: #475569; }
  .cta-button { display: inline-flex; justify-content: center; padding: .9rem 1.25rem; background: #2563eb; color: #fff; border-radius: 9px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .cta-button:hover { background: #1d4ed8; }
  @media (max-width: 700px) {
    .guides-hero { padding: 3.5rem 0 3rem; }
    .guides-section { padding: 3rem 0; }
    .section-heading, .cta-content { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .guides-grid { grid-template-columns: 1fr; }
    .guide-card { min-height: 0; }
    .cta-button { width: 100%; }
  }
</style>
