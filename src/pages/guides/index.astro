---
import Layout from "../../layouts/Layout.astro";
const guides=[
  { slug: 'how-many-portable-toilets-for-an-event', title: 'How Many Portable Toilets Do I Need for an Event?', description: 'Estimate event toilet numbers using attendance, duration, alcohol, accessibility and servicing requirements.', category: 'Event planning', readTime: '8 minute read' },
  { slug: 'wedding-toilet-hire', title: 'Wedding Toilet Hire: A Complete Planning Guide', description: 'Plan luxury toilet trailers, accessible facilities, guest capacity, venue access, utilities and supplier questions for a wedding.', category: 'Weddings', readTime: '9 minute read' },
  { slug: 'portable-toilet-hire-cost', title: 'How Much Does Portable Toilet Hire Cost?', description: 'Compare indicative UK prices for site toilets, event units, accessible toilets, welfare units and luxury toilet trailers.', category: 'Costs', readTime: '9 minute read' },
  { slug: 'construction-site-toilet-hire', title: 'Portable Toilet Hire for Construction Sites', description: 'Understand site toilet numbers, washing facilities, servicing, positioning and wider construction welfare responsibilities.', category: 'Construction', readTime: '10 minute read' },
  { slug: 'accessible-portable-toilet-hire', title: 'Accessible Portable Toilet Hire: Planning Guide', description: 'Plan suitable accessible toilets, routes, positioning, signage, maintenance and supplier questions.', category: 'Accessibility', readTime: '8 minute read' },
  { slug: 'festival-toilet-hire', title: 'Portable Toilets for Festivals and Large Events', description: 'Plan toilet numbers, urinals, accessible facilities, servicing, campsites and layouts.', category: 'Festivals', readTime: '10 minute read' },
  { slug: 'luxury-toilet-trailer-hire', title: 'Luxury Toilet Trailer Hire: What to Expect', description: 'Compare luxury trailer features, sizes, utilities, delivery access and quotation details.', category: 'Luxury trailers', readTime: '9 minute read' },
  { slug: 'welfare-unit-hire', title: 'Welfare Unit Hire: Toilets, Canteens and Drying Rooms', description: 'Plan construction welfare facilities, capacity, utilities, positioning and servicing.', category: 'Welfare units', readTime: '9 minute read' },
  { slug: 'portable-toilet-servicing', title: 'Portable Toilet Servicing and Emptying Explained', description: 'Understand cleaning, emptying, restocking, service frequency, access and waste checks.', category: 'Servicing', readTime: '8 minute read' }
];
---
<Layout title="Portable Toilet Hire Guides | Portaloo Online" description="Practical UK guides for portable toilets, events, weddings, festivals, construction welfare, luxury trailers and servicing."><main class="guides-page"><section class="guides-hero"><div class="container"><p class="eyebrow">Portable toilet hire advice</p><h1>Portable Toilet Hire Guides</h1><p class="hero-intro">Practical planning information for events, weddings, construction sites and temporary facilities, with clear links to suppliers serving your area.</p></div></section><section class="guides-section"><div class="container"><div class="section-heading"><div><p class="section-label">Planning resources</p><h2>Latest guides</h2></div><p>Clear answers to common questions about temporary toilet and welfare facilities.</p></div><div class="guides-grid">{guides.map((g)=>(<article class="guide-card"><div class="guide-meta"><span class="guide-category">{g.category}</span><span>{g.readTime}</span></div><h3><a href={`/guides/${g.slug}/`}>{g.title}</a></h3><p>{g.description}</p><a class="guide-link" href={`/guides/${g.slug}/`}>Read guide →</a></article>))}</div></div></section></main></Layout><style>.guides-page{background:#f8fafc;color:#0f172a}.container{width:min(1165px,calc(100% - 2rem));margin:0 auto}.guides-hero{padding:4.5rem 0 4rem;color:#fff;background:radial-gradient(circle at top right,rgba(59,130,246,.35),transparent 38%),linear-gradient(135deg,#0f172a,#172554)}.eyebrow,.section-label{color:#93c5fd;font-size:.8rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.guides-hero h1{margin:0;color:#fff;font-size:clamp(2.5rem,7vw,4.6rem)}.hero-intro{max-width:760px;color:#dbeafe;font-size:1.2rem;line-height:1.7}.guides-section{padding:4rem 0}.section-heading{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:2rem;margin-bottom:2rem}.section-heading h2{margin:0;font-size:2.6rem}.section-heading>p{color:#475569}.guides-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.guide-card{display:flex;min-height:300px;flex-direction:column;padding:1.5rem;background:#fff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 8px 30px rgba(15,23,42,.06)}.guide-meta{display:flex;justify-content:space-between;color:#64748b;font-size:.8rem}.guide-category,.guide-link{color:#2563eb;font-weight:800}.guide-card h3{font-size:1.35rem}.guide-card h3 a{color:#0f172a;text-decoration:none}.guide-card p{color:#475569;line-height:1.7}.guide-link{margin-top:auto;text-decoration:none}@media(max-width:980px){.guides-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.section-heading,.guides-grid{grid-template-columns:1fr}}</style>