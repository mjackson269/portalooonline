box h2,.tip-box strong,.sources-box h2{color:var(--blue-dark)}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.card-grid article{padding:1.25rem;background:#fff;border:1px solid var(--border);border-radius:12px}.card-grid h3{margin-top:0;color:var(--blue-dark)}.checklist{display:grid;gap:.75rem}.checklist label{display:flex;gap:.75rem;padding:1rem;background:#fff;border:1px solid var(--border);border-radius:10px;color:var(--text)}.checklist input{width:1.1rem;height:1.1rem;accent-color:var(--blue)}.faq-list{display:grid;gap:.75rem}.faq-list details{background:#fff;border:1px solid var(--border);border-radius:10px}.faq-list summary{padding:1rem 1.25rem;color:var(--navy);font-weight:800;cursor:pointer}.faq-list p{margin:0;padding:0 1.25rem 1.25rem}.sources-box a{color:var(--blue);font-weight:700}.find-suppliers{padding:2rem;background:var(--navy);border-radius:16px}.find-suppliers h2{color:#fff}.find-suppliers p{color:var(--light)}.primary-button{display:inline-flex;padding:.9rem 1.25rem;background:var(--blue);color:#fff;border-radius:9px;font-weight:800;text-decoration:none}.disclaimer{padding:1.5rem;background:#fff7ed;border:1px solid #fed7aa;border-radius:14px}.disclaimer h2{color:#9a3412}.disclaimer p{margin-bottom:0;color:#7c2d12}@media(max-width:900px){.article-layout{grid-template-columns:1fr}.contents{position:static}.contents nav{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.contents nav,.card-grid{grid-template-columns:1fr}.primary-button{width:100%;justify-content:center}}
</style>