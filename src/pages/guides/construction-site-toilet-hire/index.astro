  .article-layout{display:grid;grid-template-columns:240px minmax(0,760px);justify-content:center;gap:3rem;padding:4rem 0 5rem}.contents{position:sticky;top:6rem;align-self:start}.contents-card{padding:1.25rem;background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 8px 24px rgba(15,23,42,.04)}.contents-title{margin:0 0 1rem;color:var(--navy);font-weight:800}.contents nav{display:grid;gap:.75rem}.contents a{color:var(--text);font-size:.9rem;line-height:1.35;text-decoration:none}.contents a:hover{color:var(--blue);text-decoration:underline}.guide-content{min-width:0}.guide-content section{margin-bottom:3rem;scroll-margin-top:6rem}.guide-content h2{margin:0 0 1rem;color:var(--navy);font-size:clamp(1.65rem,3.5vw,2.2rem);line-height:1.2;letter-spacing:-.025em}.guide-content h3{margin:0 0 .75rem;color:var(--navy);font-size:1.22rem}.guide-content p,.guide-content li{color:var(--text);font-size:1rem;line-height:1.8}.guide-content ul{padding-left:1.4rem}.guide-content li+li{margin-top:.45rem}
