  .ratio-card{display:grid;gap:.4rem;margin:1.5rem 0;padding:1.5rem;background:#172554;border-radius:14px;color:#fff;text-align:center}.ratio-card strong{color:#93c5fd;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase}.ratio-card span:nth-of-type(1){font-size:1.8rem;font-weight:850}.ratio-card span:nth-of-type(2){color:var(--light)}.warning-box{padding:1.5rem;background:#fff7ed;border:1px solid #fed7aa;border-radius:14px}.warning-box strong{color:#9a3412}.warning-box p{margin-bottom:0;color:#7c2d12}
