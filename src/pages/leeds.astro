---
import Layout from "../layouts/Layout.astro";
import suppliers from "../data/leeds.json";
---

<Layout title="Portaloo Hire Leeds | Portaloo Online">
  <section class="page-header">
    <h1>Portaloo Hire in Leeds</h1>

    <p>
      Compare portable toilet hire companies serving Leeds and the
      surrounding areas.
    </p>
  </section>

  <section class="supplier-list">
    {suppliers.map((supplier) => (
      <article class:list={["supplier-card", { featured: supplier.featured }]}>
        <div class="supplier-heading">
          <h2>{supplier.company}</h2>

          {supplier.featured && (
            <span class="featured-badge">Featured supplier</span>
          )}
        </div>

        {supplier.description && (
          <p class="description">{supplier.description}</p>
        )}

        {supplier.headOffice && (
          <p>
            <strong>Head office:</strong> {supplier.headOffice}
          </p>
        )}

        {supplier.areasCovered?.length > 0 && (
          <div class="details">
            <strong>Areas covered</strong>

            <ul class="tags">
              {supplier.areasCovered.map((area) => (
                <li>{area}</li>
              ))}
            </ul>
          </div>
        )}

        {supplier.services?.length > 0 && (
          <div class="details">
            <strong>Services offered</strong>

            <ul class="tags">
              {supplier.services.map((service) => (
                <li>{service}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="actions">
          {supplier.phone && (
            <a class="button phone" href={`tel:${supplier.phone}`}>
              Call {supplier.phone}
            </a>
          )}

          {supplier.website && (
            <a
              class="button website"
              href={supplier.website}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit website
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</Layout>

<style>
  .page-header {
    max-width: 1100px;
    margin: 3rem auto 2rem;
    padding: 0 1.5rem;
  }

  .page-header h1 {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .page-header p {
    max-width: 700px;
    color: #64748b;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .supplier-list {
    display: grid;
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .supplier-card {
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .supplier-card.featured {
    border: 2px solid #2563eb;
  }

  .supplier-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .supplier-heading h2 {
    margin: 0;
    color: #0f172a;
    font-size: 1.5rem;
  }

  .featured-badge {
    padding: 0.4rem 0.75rem;
    color: #1d4ed8;
    background: #dbeafe;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .description {
    color: #475569;
    line-height: 1.7;
  }

  .details {
    margin-top: 1.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.45rem 0.75rem;
    color: #334155;
    background: #f1f5f9;
    border-radius: 999px;
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .button {
    display: inline-block;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }

  .phone {
    color: #ffffff;
    background: #2563eb;
  }

  .website {
    color: #1e293b;
    background: #e2e8f0;
  }

  @media (max-width: 600px) {
    .supplier-heading {
      display: block;
    }

    .featured-badge {
      display: inline-block;
      margin-top: 0.75rem;
    }

    .actions {
      display: grid;
    }

    .button {
      text-align: center;
    }
  }
</style>