---
import Layout from "../layouts/Layout.astro";
import suppliers from "../data/leeds.json";
---

<Layout title="Portaloo Hire Leeds | Portaloo Online">

  <main class="directory-page">

    <header class="page-header">
      <span class="location-label">West Yorkshire</span>

      <h1>Portaloo Hire Leeds</h1>

      <p>
        Compare portable toilet hire companies serving Leeds and the
        surrounding West Yorkshire area.
      </p>
    </header>

    <section class="supplier-section">
      <div class="section-heading">
        <div>
          <h2>Portable toilet suppliers</h2>
          <p>
            Browse {suppliers.length} suppliers serving Leeds and nearby areas.
          </p>
        </div>
      </div>

      <div class="supplier-grid">
        {
          suppliers.map((supplier) => (
            <article class="supplier-card">

              <div class="card-top">
                <h3>{supplier.company}</h3>

                <span class="badge">
                  Verified
                </span>
              </div>

              <p class="description">
                {supplier.description}
              </p>

              {supplier.services && supplier.services.length > 0 && (
                <ul class="service-list">
                  {supplier.services.slice(0, 4).map((service) => (
                    <li>{service}</li>
                  ))}
                </ul>
              )}

              <div class="card-footer">
                {supplier.phone && (
                  <a
                    href={`tel:${supplier.phone.replace(/\s/g, "")}`}
                    class="phone-link"
                    aria-label={`Call ${supplier.company}`}
                  >
                    <span aria-hidden="true">☎</span>
                    {supplier.phone}
                  </a>
                )}

                {supplier.website && (
                  <a
                    href={supplier.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="website-link"
                    aria-label={`Visit the ${supplier.company} website`}
                  >
                    Visit website
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>

            </article>
          ))
        }
      </div>
    </section>

  </main>

</Layout>

<style>
  .directory-page {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 64px 0 24px;
  }

  .page-header {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .location-label {
    display: inline-block;
    margin-bottom: 14px;
    padding: 7px 13px;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .page-header h1 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .page-header p {
    max-width: 650px;
    margin: 0;
    color: #64748b;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .supplier-section {
    width: 100%;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 24px;
  }

  .section-heading h2 {
    margin: 0 0 5px;
    color: #0f172a;
    font-size: 1.5rem;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
  }

  .supplier-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .supplier-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 24px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .supplier-card:hover {
    transform: translateY(-4px);
    border-color: #bfdbfe;
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.09);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .card-top h3 {
    margin: 0;
    color: #0f172a;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .badge {
    flex-shrink: 0;
    padding: 5px 9px;
    color: #166534;
    background: #dcfce7;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .description {
    margin: 0 0 18px;
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .service-list li {
    padding: 6px 9px;
    color: #334155;
    background: #f1f5f9;
    border-radius: 7px;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid #e2e8f0;
  }

  .phone-link,
  .website-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    text-decoration: none;
    font-weight: 700;
  }

  .phone-link {
    color: #334155;
  }

  .phone-link:hover {
    color: #0f172a;
  }

  .website-link {
    color: #2563eb;
  }

  .website-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  @media (max-width: 950px) {
    .supplier-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .directory-page {
      width: min(100% - 28px, 1180px);
      padding-top: 40px;
    }

    .page-header {
      margin-bottom: 36px;
    }

    .supplier-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .supplier-card {
      padding: 20px;
    }

    .card-top {
      flex-direction: column;
    }
  }
</style>