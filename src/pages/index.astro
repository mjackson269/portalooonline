---
import Layout from "../layouts/Layout.astro";

const cities = [
  "Bradford",
  "Leeds",
  "Sheffield",
  "York",
  "Hull"
];
---

<Layout title="Portaloo Online | Find Portable Toilet Hire Across the UK">

  <section class="hero container">
    <h1>Find Portaloo Hire Companies Across the UK</h1>

    <p>
      Compare portable toilet hire companies serving Yorkshire.
      Find suppliers for events, weddings, festivals, construction
      sites and welfare units.
    </p>
  </section>

  <section class="cities container">
    <h2>Browse by Location</h2>

    <div class="grid">
      {cities.map(city => (
        <a
          href={`/${city.toLowerCase()}/`}
          class="card"
        >
          <h3>{city}</h3>
          <p>View suppliers in {city}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="about">
    <h2>About Portaloo Online</h2>

    <p>
      Portaloo Online helps customers find portable toilet hire
      companies throughout Yorkshire. Whether you need a single site
      toilet, luxury toilet trailer, welfare unit or accessible
      facilities, our directory helps you compare suppliers quickly.
    </p>
  </section>

</Layout>

<style>
.hero {
  text-align: center;
  max-width: 800px;
  margin: 4rem auto;
}

.hero h1 {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.hero p {
  font-size: 1.2rem;
  color: #555;
}

.cities {
  max-width: 1000px;
  margin: 3rem auto;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.card {
  background: #f5f5f5;
  padding: 1.5rem;
  border-radius: 12px;
  text-decoration: none;
  color: #222;
  transition: 0.2s;
}

.card:hover {
  transform: translateY(-3px);
  background: #e8f1ff;
}

.about {
  max-width: 800px;
  margin: 4rem auto;
}

.about p {
  line-height: 1.7;
}
</style>