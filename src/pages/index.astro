---
import Layout from "../layouts/Layout.astro";

const cities = [
  {
    name: "Bradford",
    suppliers: 12
  },
  {
    name: "Leeds",
    suppliers: 15
  },
  {
    name: "Sheffield",
    suppliers: 14
  },
  {
    name: "York",
    suppliers: 17
  },
  {
    name: "Hull",
    suppliers: 16
  }
];
---

<Layout title="Portaloo Online | Find Portable Toilet Hire Across Yorkshire">

  <section class="hero">

    <span class="tag">
      Yorkshire Portaloo Directory
    </span>

    <h1>
      Find Trusted Portable Toilet Hire Companies Near You
    </h1>

    <p>
      Compare suppliers for events, weddings,
      festivals, construction sites and welfare units
      across Yorkshire.
    </p>

    <div class="search-mockup">
      📍 Serving Leeds, Bradford, Sheffield, York & Hull
    </div>

  </section>

  <section class="trust">

    <div>✅ Verified Suppliers</div>
    <div>✅ Event Toilet Hire</div>
    <div>✅ Construction Site Toilets</div>
    <div>✅ Yorkshire Coverage</div>

  </section>

  <section class="cities">

    <h2>Browse by Location</h2>

    <div class="grid">

      {cities.map(city => (

        <a
          href={`/${city.name.toLowerCase()}/`}
          class="card"
        >

          <div class="city-icon">
            📍
          </div>

          <h3>{city.name}</h3>

          <p class="supplier-count">
            {city.suppliers} suppliers available
          </p>

          <p>
            Compare portable toilet hire companies
            serving {city.name}.
          </p>

        </a>

      ))}

    </div>

  </section>

  <section class="about">

    <h2>About Portaloo Online</h2>

    <p>
      Portaloo Online helps customers find portable toilet
      hire companies throughout Yorkshire.
    </p>

    <p>
      Whether you need a single site toilet,
      luxury toilet trailer, welfare unit,
      accessible facilities or event sanitation,
      our directory helps you compare local suppliers
      quickly and easily.
    </p>

  </section>

</Layout>

<style>

.hero {
  text-align: center;
  max-width: 850px;
  margin: 5rem auto;
}

.tag {
  display: inline-block;
  background: #dbeafe;
  color: #2563eb;
  padding: 8px 18px;
  border-radius: 999px;
  font-weight: 600;
  margin-bottom: 1rem;
}

.hero h1 {
  font-size: 4rem;
  line-height: 1.1;
  margin: 1rem 0;
}

.hero p {
  font-size: 1.2rem;
  color: #64748b;
  max-width: 700px;
  margin: 0 auto;
}

.search-mockup {
  margin-top: 2rem;
  background: white;
  border-radius: 16px;
  padding: 20px;
  font-weight: 600;

  box-shadow:
    0 10px 30px rgba(0,0,0,.08);
}

.trust {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;

  margin: 3rem auto;

  color: #475569;
  font-weight: 600;
}

.cities {
  max-width: 1200px;
  margin: 4rem auto;
}

.cities h2 {
  text-align: center;
  margin-bottom: 2rem;
}

.grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(250px, 1fr));

  gap: 1.2rem;
}

.card {

  background: white;

  border-radius: 16px;

  padding: 24px;

  text-decoration: none;

  color: inherit;

  box-shadow:
    0 2px 8px rgba(0,0,0,.05);

  transition: all .2s ease;
}

.card:hover {

  transform: translateY(-4px);

  box-shadow:
    0 12px 30px rgba(0,0,0,.08);
}

.city-icon {
  font-size: 2rem;
  margin-bottom: .5rem;
}

.card h3 {
  margin: 0;
  font-size: 1.3rem;
}

.supplier-count {
  font-weight: 700;
  color: #2563eb;
  margin: .5rem 0;
}

.card p {
  color: #64748b;
}

.about {
  max-width: 800px;
  margin: 5rem auto;
}

.about h2 {
  text-align: center;
  margin-bottom: 1rem;
}

.about p {
  line-height: 1.8;
  color: #475569;
}

@media (max-width: 768px) {

  .hero h1 {
    font-size: 2.5rem;
  }

  .hero p {
    font-size: 1rem;
  }

}

</style>