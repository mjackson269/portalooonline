---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>

<link
rel="preconnect"
href="https://fonts.googleapis.com"
/>

<link
href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
rel="stylesheet"
/>

</head>

<body>

<header>

<div class="container">

<a href="/" class="logo">
🚽 Portaloo Online
</a>

<nav>

<a href="/">Home</a>
<a href="/leeds/">Leeds</a>
<a href="/bradford/">Bradford</a>
<a href="/sheffield/">Sheffield</a>
<a href="/york/">York</a>
<a href="/hull/">Hull</a>

</nav>

</div>

</header>

<main>

<slot />

</main>

<footer>

<div class="container">

© 2026 Portaloo Online

</div>

</footer>

</body>

</html>

<style is:global>

:root {

--blue:#2563eb;
--dark:#0f172a;
--grey:#64748b;
--background:#f8fafc;

}

* {
box-sizing:border-box;
}

body {

margin:0;
font-family:'Inter',sans-serif;
background:var(--background);
color:var(--dark);

}

.container {

max-width:1200px;
margin:auto;
padding:0 24px;

}

header {

background:white;
border-bottom:1px solid #e5e7eb;

}

header .container {

display:flex;
justify-content:space-between;
align-items:center;
padding:20px 24px;

}

.logo {

font-size:1.2rem;
font-weight:800;
text-decoration:none;
color:var(--dark);

}

nav {

display:flex;
gap:20px;

}

nav a {

text-decoration:none;
color:var(--grey);

}

nav a:hover {

color:var(--blue);

}

footer {

text-align:center;
padding:50px 0;
margin-top:80px;
color:var(--grey);

}

@media(max-width:768px){

header .container{

flex-direction:column;
gap:20px;

}

nav{

flex-wrap:wrap;
justify-content:center;

}

}

</style>