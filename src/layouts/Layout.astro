---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>

  <meta
    name="description"
    content="Find portable toilet hire companies across Yorkshire and the UK."
  />

  <link rel="icon" href="/favicon.svg" />
</head>

<body>

<header>
  <div class="container">

    <a href="/" class="logo">
      Portaloo Online
    </a>

    <nav>
      <a href="/">Home</a>
      <a href="/leeds/">Leeds</a>
      <a href="/bradford/">Bradford</a>
      <a href="/sheffield/">Sheffield</a>
      <a href="/york/">York</a>
      <a href="/hull/">Hull</a>
    </nav>

  </div>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="container">

    <p>
      © 2026 Portaloo Online
    </p>

    <p>
      Find portable toilet hire companies across Yorkshire.
    </p>

  </div>
</footer>

</body>
</html>

<style is:global>

:root {
  --primary: #0066cc;
  --dark: #222;
  --light: #f5f7fa;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family:
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: white;
  color: var(--dark);
  line-height: 1.6;
}

.container {
  width: min(1100px, 92%);
  margin: auto;
}

header {
  background: white;
  border-bottom: 1px solid #ddd;
  position: sticky;
  top: 0;
  z-index: 100;
}

header .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 70px;
}

.logo {
  font-size: 1.4rem;
  font-weight: 700;
  text-decoration: none;
  color: var(--primary);
}

nav {
  display: flex;
  gap: 1rem;
}

nav a {
  text-decoration: none;
  color: var(--dark);
  font-weight: 500;
}

nav a:hover {
  color: var(--primary);
}

main {
  min-height: 75vh;
  padding: 2rem 0;
}

footer {
  background: var(--light);
  padding: 2rem 0;
  margin-top: 4rem;
  text-align: center;
}

h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

h2 {
  margin-bottom: 1rem;
  margin-top: 2rem;
}

p {
  margin-bottom: 1rem;
}

.card {
  background: white;
  border: 1px solid #ddd;
  border-radius: 12px;
  padding: 1.25rem;
}

@media (max-width: 768px) {

  header .container {
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
  }

  nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  h1 {
    font-size: 2rem;
  }

}
</style>