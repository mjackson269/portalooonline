---
const { title } = Astro.props;
---

<html lang="en">
<head>
  <title>{title}</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 1200px;
      margin: auto;
      padding: 20px;
      background: #f5f7fa;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    nav a {
      margin-right: 15px;
    }
  </style>

</head>

<body>

<nav>
  <a href="/">Home</a>
  <a href="/leeds/">Leeds</a>
  <a href="/bradford/">Bradford</a>
  <a href="/sheffield/">Sheffield</a>
  <a href="/york/">York</a>
  <a href="/hull/">Hull</a>
</nav>

<slot />

</body>
</html>