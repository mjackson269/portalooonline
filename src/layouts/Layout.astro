---
const { title = "Portaloo Online" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Find portable toilet hire companies for events, weddings and construction sites."
    />

    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          Portaloo <span>Online</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/bradford/">Bradford</a>
          <a href="/leeds/">Leeds</a>
          <a href="/sheffield/">Sheffield</a>
          <a href="/york/">York</a>
          <a href="/hull/">Hull</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 Portaloo Online</p>
        <p>Find portable toilet hire companies across Yorkshire.</p>
      </div>
    </footer>
  </body>

  <style is:global>
    :root {
      --primary: #166534;
      --primary-dark: #14532d;
      --accent: #22c55e;
      --navy: #0f172a;
      --text: #334155;
      --muted: #64748b;
      --background: #f8fafc;
      --surface: #ffffff;
      --border: #e2e8f0;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behaviour: smooth;
    }

    body {
      margin: 0;
      background: var(--background);
      color: var(--navy);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    main {
      min-height: 70vh;
    }

    a {
      color: inherit;
    }

    .container {
      width: min(1180px, calc(100% - 40px));
      margin-inline: auto;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.96);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 72px;
      gap: 32px;
    }

    .logo {
      color: var(--navy);
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      text-decoration: none;
      white-space: nowrap;
    }

    .logo span {
      color: var(--primary);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      color: var(--text);
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
    }

    nav a:hover {
      color: var(--primary);
    }

    .site-footer {
      margin-top: 80px;
      padding: 48px 0;
      background: var(--navy);
      color: #cbd5e1;
      text-align: center;
    }

    .site-footer p {
      margin: 5px 0;
    }

    @media (max-width: 800px) {
      .header-inner {
        align-items: flex-start;
        flex-direction: column;
        gap: 14px;
        padding-block: 18px;
      }

      nav {
        width: 100%;
        gap: 16px;
        overflow-x: auto;
        padding-bottom: 4px;
      }

      nav a {
        white-space: nowrap;
      }
    }
  </style>
</html>